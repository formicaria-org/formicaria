# Rust
/target/
**/target/

# Node / frontend
node_modules/
ui/dist/
ui/.svelte-kit/

# mdBook rendered output (source is docs/src; the built site is disposable)
docs/book/

# pixi (the locked env lives in pixi.lock, which IS tracked; the installed env is not)
.pixi/

# The knowledge vault is its own independent git repo — never track it from the app repo
/vault/

# The dev loop's vault list (pixi's `serve` points FM_VAULTS here). Per-machine, and it
# exists precisely so creating a vault in the app never writes your real
# ~/.config/formicaria/vaults.json — which would then win over FM_VAULT and make ./vault
# silently vanish from `pixi run serve`.
/.dev-vaults.json

# OS / editor cruft
.DS_Store
*.swp
*~

# Excalidraw's fonts, copied out of node_modules by ui/scripts/copy-excalidraw-fonts.mjs
# on every build. Generated, so never committed: a checked-in copy is one that silently
# goes stale the moment @excalidraw/excalidraw is bumped, and stale fonts are drift nobody
# notices. Any build regenerates them.
ui/public/fonts/

# The Android toolchain, unpacked in-tree by `pixi run android-init`: platform-tools (adb),
# the NDK, cmdline-tools. Every one of them is a standalone zip rather than an installer, so
# they live here instead of becoming a system requirement a checkout cannot pin or remove
# (`docs/context/decisions.md`, the owner's ruling 3). Hundreds of MB of vendor binaries and
# entirely reconstructible from `android/toolchain.lock`, so never committed — the *lock* is
# what is committed, and it is what makes the unpacked tree reproducible.
.android/

# The Android shell's generated Gradle project and build output. `tauri android init`
# regenerates gen/android from tauri.conf.json + the package identifier, and it embeds absolute
# paths, so committing it would be committing this machine. The hand-written half of the shell
# (src-tauri/src, Cargo.toml, tauri.conf.json, icons) IS tracked.
mobile/src-tauri/gen/
mobile/src-tauri/target/
mobile/node_modules/

# The signed release APK, written beside the shell by `pixi run android-release`. A build
# artifact reconstructible from the source + the keystore, and ~19 MB — the pre-commit size
# guard rejects it, correctly. What is committed is the script that builds it.
mobile/*.apk
