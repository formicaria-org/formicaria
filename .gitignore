# Rust
/target/
**/target/

# Node / frontend
node_modules/
ui/dist/
ui/.svelte-kit/

# mdBook rendered output (source is docs/src; the built site is disposable)
docs/book/

# pixi (the locked env lives in pixi.lock, which IS tracked; the installed env is not)
.pixi/

# The knowledge vault is its own independent git repo — never track it from the app repo
/vault/

# OS / editor cruft
.DS_Store
*.swp
*~

# Excalidraw's fonts, copied out of node_modules by ui/scripts/copy-excalidraw-fonts.mjs
# on every build. Generated, so never committed: a checked-in copy is one that silently
# goes stale the moment @excalidraw/excalidraw is bumped, and stale fonts are drift nobody
# notices. Any build regenerates them.
ui/public/fonts/
