  "for": [
   "bar",
   "free weights",
   "machine"
  ],
  "tips": [
   {
    "head": "Breathe regularly during strength exercises.",
    "text": "For example, breathe out as you lift the weight, and breathe in as you relax. When doing leg lifts, breathe out as you lift your leg and breathe in as you lower it."
   },
   {
    "head": "Use smooth, steady movements when lifting weights.",
    "text": "To prevent injury, don’t jerk or thrust weights into position."
   },
   {
    "head": "Keep your arm and leg joints slightly bent.",
    "text": "Avoid “locking” your arm and leg joints in a tightly straightened position."
   },
   {
    "head": "Choose a sturdy chair with arms.",
    "text": "Make sure the chair is stable enough to support you when seated or when holding on during the exercise."
   },
   {
    "head": "Make slow, steady movements.",
    "text": "Never “bounce” into a stretch."
   },
   {
    "head": "Always bend forward from the hips, not the waist.",
    "text": "If you keep your back straight, you’re bending the right way."
   },
   {
    "head": "Stop if you feel pain.",
    "text": "You might feel some soreness after you exercise, but exercise should not hurt or make you feel really tired. In fact, in many ways, being active will probably make you feel better."
   }
  ]
 },
