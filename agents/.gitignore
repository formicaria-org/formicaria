# The runtime binary + its shared libs, and the model weights, live here but never travel: they are
# large, machine-specific, and re-fetchable from models.toml. Only the manifest + scripts commit.
runtime/
models/
*.log
# Written by `pixi run catalogue` (and by `pixi run build`) from the agent-serve this checkout
# builds: the catalogue now ships inside Myrme. Its presence is how fm-serve knows it runs from a
# checkout, so it must exist here, and it must not be edited in git.
models.toml
