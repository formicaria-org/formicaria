{
  "manifest_version": 2,
  "name": "formicaria",
  "description": "Keep the page you are on in your formicaria notebook: a recipe, a paper, an article, a video or a song, with a copy of the page.",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": { "id": "browser@formicaria-org.github.io", "strict_min_version": "128.0" }
  },
  "permissions": ["activeTab", "tabs", "storage", "contextMenus", "notifications", "http://127.0.0.1/*"],
  "background": { "scripts": ["background.js"], "persistent": false },
  "browser_action": {
    "default_title": "Keep this page in formicaria",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "icons": { "48": "icon.svg", "96": "icon.svg" }
}
