{
  "manifest_version": 2,
  "name": "formicaria",
  "description": "formicaria's browser actions: keep the page you are on, add a passage to the note open in formicaria, see which notes name a page, and keep downloads, in your formicaria notebook.",
  "version": "1.3.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "browser@formicaria-org.github.io",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "contextMenus",
    "notifications",
    "downloads",
    "theme",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Keep this page in formicaria (Alt+Shift+K)",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "commands": {
    "keep-page": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Keep this page in formicaria"
    },
    "add-to-note": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Add the selection, or this page's link, to the note open in formicaria"
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "omnibox": {
    "keyword": "fm"
  }
}
