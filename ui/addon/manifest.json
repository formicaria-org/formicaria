{
  "manifest_version": 2,
  "name": "formicaria",
  "description": "formicaria's browser actions: bring what you select on a page into the note open in formicaria, save whole pages, see which notes name a page, and keep downloads, in your formicaria notebook.",
  "version": "1.5.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "browser@formicaria-org.github.io",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "contextMenus",
    "notifications",
    "downloads",
    "theme",
    "<all_urls>",
    "menus"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "commands": {
    "keep-page": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Save this page in formicaria"
    },
    "add-to-note": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Bring the selection (or the page's link) into the note in front in formicaria"
    },
    "snip": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Snip an area of the page into the note in front in formicaria"
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "select.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "omnibox": {
    "keyword": "fm"
  },
  "page_action": {
    "default_icon": "icon-page.svg",
    "default_title": "Snip what to bring into formicaria, or save the whole page (Alt+Shift+S)",
    "show_matches": [
      "http://*/*",
      "https://*/*"
    ],
    "pinned": true
  }
}
