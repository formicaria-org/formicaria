{
  "manifest_version": 2,
  "name": "formicaria",
  "description": "formicaria's browser actions: keep the page you are on, bookmark it, and keep downloads, in your formicaria notebook.",
  "version": "1.2.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "browser@formicaria-org.github.io",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "contextMenus",
    "notifications",
    "downloads",
    "theme",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "browser_action": {
    "default_title": "Keep this page in formicaria (Alt+Shift+K)",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "commands": {
    "keep-page": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Keep this page in formicaria"
    },
    "show-formicaria": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Bring formicaria forward"
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  }
}
