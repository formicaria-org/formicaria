# formicaria's branding, over Firefox's (chrome://branding/). Registered by formicaria.cfg.
override chrome://branding/locale/brand.properties branding/brand.properties
override chrome://branding/content/icon16.png branding/icon16.png
override chrome://branding/content/icon32.png branding/icon32.png
override chrome://branding/content/icon48.png branding/icon48.png
override chrome://branding/content/icon64.png branding/icon64.png
override chrome://branding/content/icon128.png branding/icon128.png
override chrome://branding/content/about-logo.png branding/about-logo.png
override chrome://branding/content/about-logo@2x.png branding/about-logo@2x.png
override chrome://branding/content/about-logo.svg branding/about-logo.svg
override chrome://branding/content/about-wordmark.svg branding/about-wordmark.svg
# Firefox's mascot on the default-browser card (Settings) becomes formicaria's mark.
override chrome://global/skin/illustrations/kit-concerned.svg branding/about-logo.svg
